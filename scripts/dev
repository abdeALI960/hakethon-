#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PYTHON="$ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  PYTHON="$(command -v python3 || command -v python || true)"
fi
command -v "$PYTHON" >/dev/null 2>&1 || {
  echo "Python was not found. Create .venv or install Python 3.10+." >&2
  exit 1
}
command -v npm >/dev/null 2>&1 || {
  echo "npm was not found. Install Node.js and npm first." >&2
  exit 1
}

mkdir -p .dev-logs
demo_pid=""
backend_pid=""
frontend_pid=""
cleanup() {
  trap - INT TERM EXIT
  for pid in "$frontend_pid" "$backend_pid" "$demo_pid"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  [[ -z "$frontend_pid" ]] || wait "$frontend_pid" 2>/dev/null || true
  [[ -z "$backend_pid" ]] || wait "$backend_pid" 2>/dev/null || true
  [[ -z "$demo_pid" ]] || wait "$demo_pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

echo "Starting loopback demo services on ports 5001-5003..."
"$PYTHON" -m backend.demo_services.launcher >.dev-logs/demo-services.log 2>&1 &
demo_pid=$!

echo "Starting backend on http://127.0.0.1:5000 (CHAOS_ENABLED=true, local dev only)..."
CHAOS_ENABLED=true "$PYTHON" -m uvicorn backend.main:app --host 127.0.0.1 --port 5000 --reload \
  >.dev-logs/backend.log 2>&1 &
backend_pid=$!

echo "Starting frontend on http://localhost:3000..."
npm run dev -- --host 127.0.0.1 >.dev-logs/frontend.log 2>&1 &
frontend_pid=$!

echo "OpsPilot is starting. Logs: .dev-logs/{demo-services,backend,frontend}.log"
echo "Press Ctrl-C to stop all three launchers."
while true; do
  for pid in "$demo_pid" "$backend_pid" "$frontend_pid"; do
    if ! kill -0 "$pid" 2>/dev/null; then
      status=0
      wait "$pid" || status=$?
      echo "A development process exited (status $status)." >&2
      exit "$status"
    fi
  done
  sleep 1
done
